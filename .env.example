# Ambiente local. Troque senhas e origens antes de publicar.
APP_ENV=development
APP_ORIGIN=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
HTTP_PORT=8080
JWT_SECRET=development-only-secret-change-me
UPLOAD_DIR=/data/uploads

POSTGRES_DB=tucano
POSTGRES_USER=tucano
POSTGRES_PASSWORD=change-me-before-production

# Fases futuras: somente assinatura do software, nunca o valor do serviço.
MERCADOPAGO_ACCESS_TOKEN=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_ADMIN_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# E-mails transacionais de autenticação. Em desenvolvimento, links são
# devolvidos somente na resposta local quando SMTP_HOST está vazio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
